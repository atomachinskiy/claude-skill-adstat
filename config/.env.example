# Adstat (Magnetto Cabinet) credentials
# Заполни своими данными от https://client.adstat.pro
# После заполнения: chmod 600 config/.env, потом запусти scripts/auth-relogin.sh

ADSTAT_LOGIN=твой@email.ru
ADSTAT_PASSWORD=твойпароль

# Опционально (для override в продвинутых сценариях):
# ADSTAT_BASE=https://client.adstat.pro
